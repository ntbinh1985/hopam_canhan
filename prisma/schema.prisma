datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Song {
  id        Int      @id @default(autoincrement())
  title     String
  artist    String?
  key       String   // Tone gốc (vd: "C", "Am")
  rhythm    String?  // Điệu (vd: "Ballad")
  content   String   // Lời bài hát chứa hợp âm dạng [C], [G]...
  createdAt DateTime @default(now())
}