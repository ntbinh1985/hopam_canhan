datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Song {
  id         Int      @id @default(autoincrement())
  title      String
  artist     String?
  key        String   
  rhythm     String?  
  genre      String?  
  notes      String?  // Bảng ghi chú, Solo Tab
  isFavorite Boolean  @default(false) // Đánh dấu sao yêu thích
  content    String   
  createdAt  DateTime @default(now())
}
