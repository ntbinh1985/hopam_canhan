datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Song {
  id        Int      @id @default(autoincrement())
  title     String
  artist    String?
  key       String   // Tone gốc
  rhythm    String?  // Điệu
  genre     String?  // Thể loại nhạc (TRƯỜNG MỚI)
  content   String   // Lời và hợp âm
  createdAt DateTime @default(now())
}