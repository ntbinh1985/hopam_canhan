datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Song {
  id           Int      @id @default(autoincrement())
  title        String
  artist       String?
  key          String   
  rhythm       String?  
  genre        String?  
  notes        String?  
  youtubeLinks String?  
  isFavorite   Boolean  @default(false) 
  content      String   
  createdAt    DateTime @default(now())
}
